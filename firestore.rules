rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users collection - each user can only read/write their own profile
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // User profiles collection - maps auth UID to student_id
    match /user_profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // Only backend can write
    }

    // Students collection - authenticated users can read any student profile
    match /students/{student_id} {
      allow read: if isAuth();
      allow write: if false; // Only backend can write
    }

    // Helper function to check if user owns this resource via user_profiles
    function getUserStudentId() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.student_id;
    }

    // Goals collection - authenticated users can read/write their own goals
    match /goals/{document=**} {
      allow read, write: if isAuth() && resource.data.student_id == getUserStudentId();
      allow create: if isAuth() && request.resource.data.student_id == getUserStudentId();
    }

    // Conversations collection - authenticated users can read/write their own conversations
    match /conversations/{document=**} {
      allow read, write: if isAuth() && resource.data.student_id == getUserStudentId();
      allow create: if isAuth() && request.resource.data.student_id == getUserStudentId();
    }

    // Session transcripts collection - users can read their own transcripts
    match /session_transcripts/{document=**} {
      allow read: if isAuth() && resource.data.student_id == getUserStudentId();
      allow write: if false; // Only backend can write
    }

    // Quizzes collection
    match /quizzes/{document=**} {
      allow read, write: if isAuth() && resource.data.student_id == getUserStudentId();
      allow create: if isAuth() && request.resource.data.student_id == getUserStudentId();
    }

    // Quiz results collection
    match /quiz_results/{document=**} {
      allow read, write: if isAuth() && resource.data.student_id == getUserStudentId();
      allow create: if isAuth() && request.resource.data.student_id == getUserStudentId();
    }

    // Recommendations collection
    match /recommendations/{document=**} {
      allow read, write: if isAuth() && resource.data.student_id == getUserStudentId();
      allow create: if isAuth() && request.resource.data.student_id == getUserStudentId();
    }

    // Nudge logs collection
    match /nudge_logs/{document=**} {
      allow read: if isAuth() && resource.data.student_id == getUserStudentId();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}

