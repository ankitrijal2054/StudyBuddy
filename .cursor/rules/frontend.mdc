## Error Handling

```jsx
import toast from "react-hot-toast";

// In components
try {
  const result = await api.call("/api/chat", "POST", { message });
  setMessages([...messages, result]);
} catch (error) {
  toast.error("Failed to send message. Try again.");
  console.error(error);
}
```

## Protected Routes

```jsx
// App.jsx
import { useAuth } from "./hooks/useAuth";

function App() {
  const { currentUser, loading } = useAuth();

  if (loading) return <LoadingSpinner />;

  return (
    <Routes>
      <Route path="/login" element={<Login />} />
      <Route path="/register" element={<Register />} />

      {currentUser ? (
        <>
          <Route path="/dashboard" element={<Dashboard />} />
          <Route path="/chat" element={<Chat />} />
          <Route path="/quiz" element={<Quiz />} />
          <Route path="/" element={<Navigate to="/dashboard" />} />
        </>
      ) : (
        <Route path="*" element={<Navigate to="/login" />} />
      )}
    </Routes>
  );
}
```

## Message Handling Pattern

```jsx
// Chat.jsx - Example of complex state with useReducer
function chatReducer(state, action) {
  switch (action.type) {
    case 'ADD_MESSAGE':
      return {
        ...state,
        messages: [...state.messages, action.payload],
      };
    case 'SET_LOADING':
      return { ...state, loading: action.payload };
    case 'SET_ERROR':
      return { ...state, error: action.payload };
    default:
      return state;
  }
}

export function Chat() {
  const [state, dispatch] = useReducer(chatReducer, {
    messages: [],
    loading: false,
    error: null,
  });

  const handleSend = async (message) => {
    dispatch({ type: 'ADD_MESSAGE', payload: { role: 'user', content: message } });
    dispatch({ type: 'SET_LOADING', payload: true });

    try {
      const response = await api.call('/api/chat', 'POST', { message });
      dispatch({ type: 'ADD_MESSAGE', payload: { role: 'assistant', content: response.response } });
    } catch (error) {
      dispatch({ type: 'SET_ERROR', payload: error.message });
    } finally {
      dispatch({ type: 'SET_LOADING', payload: false });
    }
  };

  return (
    // Component JSX
  );
}
```

