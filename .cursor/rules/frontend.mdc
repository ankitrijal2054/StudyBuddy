# Frontend Rules - React + Tailwind

## Component Structure

### Page Components (pages/)

```jsx
export function Dashboard() {
  const { currentUser } = useAuth();
  const [goals, setGoals] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!currentUser) return;
    // Attach Firestore listener
    const unsubscribe = onSnapshot(
      query(
        collection(db, "goals"),
        where("student_id", "==", currentUser.uid)
      ),
      (snapshot) => {
        setGoals(snapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() })));
        setLoading(false);
      }
    );
    return unsubscribe;
  }, [currentUser]);

  if (loading) return <LoadingSpinner />;

  return (
    <div className="min-h-screen bg-gradient-to-br from-indigo-50 to-teal-50">
      {/* Page content */}
    </div>
  );
}
```

### UI Components (components/)

- **Keep under 200 lines** (else split into smaller components)
- **Props only** (no business logic)
- **Consistent prop interface**: `{ data, onAction, isLoading }`
- **Error boundaries**: Catch errors in components

```jsx
export function GoalCard({ goal, onContinue }) {
  const progressPercent = goal.progress || 0;

  return (
    <div className="p-4 bg-white rounded-lg shadow-sm border border-indigo-100">
      <h3 className="font-semibold text-indigo-900">{goal.subject}</h3>
      <p className="text-sm text-gray-600 mt-1">{goal.goal}</p>
      <div className="mt-3 w-full bg-gray-200 rounded-full h-2">
        <div
          className="bg-indigo-600 h-2 rounded-full transition-all"
          style={{ width: `${progressPercent}%` }}
        />
      </div>
      <button
        onClick={onContinue}
        className="mt-3 w-full px-3 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
      >
        Continue Learning
      </button>
    </div>
  );
}
```

## Hooks Pattern

### Custom Hooks (hooks/)

Always follow this pattern:

```jsx
export function useAuth() {
  const [currentUser, setCurrentUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (user) => {
      setCurrentUser(user);
      setLoading(false);
    });
    return unsubscribe;
  }, []);

  return { currentUser, loading, error };
}

export function useAPI() {
  const { currentUser } = useAuth();

  const call = useCallback(
    async (endpoint, method = "GET", body = null) => {
      const token = await currentUser?.getIdToken();
      const response = await fetch(
        `${process.env.VITE_CLOUD_RUN_URL}${endpoint}`,
        {
          method,
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: body ? JSON.stringify(body) : null,
        }
      );
      return response.json();
    },
    [currentUser]
  );

  return { call };
}
```

## Real-Time Listeners

```jsx
useEffect(() => {
  if (!currentUser) return;

  // Query with filters
  const q = query(
    collection(db, "quiz_results"),
    where("student_id", "==", currentUser.uid),
    orderBy("completed_at", "desc"),
    limit(10)
  );

  // Attach real-time listener
  const unsubscribe = onSnapshot(q, (snapshot) => {
    const results = snapshot.docs.map((doc) => ({
      id: doc.id,
      ...doc.data(),
    }));
    setQuizResults(results);
  });

  // Cleanup
  return unsubscribe;
}, [currentUser]);
```

